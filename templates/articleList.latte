<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>List</title>
    </head>
    <body>
        {foreach $lists as $list}
        <div>
            <h2>{$list['0']}</h2>
            <p>{$list['1']}</p>
            <p>{$list['2']}</p>
            <hr />
        </div>
        {/foreach}
    </body>
</html>
